{
  "name": "lvrs-svelte",
  "version": "0.2.1",
  "description": "LVRS visual components, materials and elastic interactions for Svelte 5",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run prepack && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "npm run sync:theme && svelte-kit sync && svelte-package -o build/package && publint",
    "test": "node --test tests/*.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pack:dry": "npm pack --dry-run",
    "sync:theme": "node scripts/generate-theme.mjs"
  },
  "files": [
    "build/package",
    "NOTICE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./build/package/index.js",
  "types": "./build/package/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/package/index.d.ts",
      "svelte": "./build/package/index.js"
    },
    "./theme": {
      "types": "./build/package/theme/index.d.ts",
      "default": "./build/package/theme/index.js"
    },
    "./motion": {
      "types": "./build/package/motion.d.ts",
      "default": "./build/package/motion.js"
    },
    "./styles.css": "./build/package/styles.css",
    "./theme.css": "./build/package/theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "publint": "^0.3.17",
    "svelte": "^5.53.0",
    "svelte-check": "^4.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "keywords": [
    "lvrs",
    "svelte",
    "component-library",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iisacc-Justmoong/LVRS-Svelte.git"
  },
  "homepage": "https://github.com/iisacc-Justmoong/LVRS-Svelte#readme"
}
